{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "npm run test:e2e:build && wdio run e2e/wdio.conf.ts",
    "test:e2e:build": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "test:e2e:build:mac": "npm run build && cargo build --release --features e2e --manifest-path src-tauri/Cargo.toml",
    "test:e2e:mac": "npm run test:e2e:build:mac && wdio run e2e/wdio.conf.ts",
    "test:e2e:only": "wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/papaparse": "^5.5.2",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "^2.0.9",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "webdriverio": "^9.27.0"
  }
}
